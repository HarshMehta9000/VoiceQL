    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "gifenc": "^1.0.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
