{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "oracle": "python3 scripts/build-oracle.py",
    "verify:oracle": "node scripts/verify-oracle.mjs",
    "verify:findings": "node scripts/verify-findings.mjs",
    "verify": "npm run verify:oracle && npm run verify:findings",
