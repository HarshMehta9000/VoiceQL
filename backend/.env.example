# VoiceQL Environment Variables
# Copy this file to .env and fill in your keys

# Required for STT (speech-to-text via Whisper)
OPENAI_API_KEY=sk-...

# Optional — use Claude as LLM instead of GPT-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...

# Path to your Google Cloud TTS JSON credentials file
GOOGLE_TTS_CREDENTIALS=credentials/google_tts.json

# Database path (SQLite)
DATABASE_URL=data/voiceql.db

# TTS voice options: en-US-Journey-F, en-US-Journey-D, en-US-Neural2-F
TTS_VOICE=en-US-Journey-F
TTS_LANGUAGE=en-US
